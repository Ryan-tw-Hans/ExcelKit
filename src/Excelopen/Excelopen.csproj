<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <ProjectName>ExcelKit</ProjectName>
    <AssemblyName>ExcelKit</AssemblyName>
    <RootNamespace>ExcelKit</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- 版本資訊 -->
    <Version>1.2.4+20261117094415</Version>
    <AssemblyVersion>1.2.4.0</AssemblyVersion>
    <FileVersion>1.2.4.3</FileVersion>
    <InformationalVersion>1.2.4+20261117094415</InformationalVersion>

    <!-- 套件資訊 -->
    <Title>ExcelKit</Title>
    <Description>ExcelKit</Description>
    <Authors>ExcelKit Team</Authors>
    <Company>ExcelKit</Company>
    <Product>ExcelKit</Product>
  </PropertyGroup>

  <!-- Net472 特殊配置 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);NET472</DefineConstants>
    <!-- 注: COM 注册需要在 Visual Studio 或使用 regasm.exe 手动进行 -->
  </PropertyGroup>

  <!-- Net10 配置 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);NET10</DefineConstants>
    <!-- 禁用 Fody，因為 .NET 10 不需要 DLL 合併 -->
    <DisableFody>true</DisableFody>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- 所有目標框架的依賴 -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" PrivateAssets="All" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="All" />
    <PackageReference Include="Fody" Version="6.8.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.0" />
  </ItemGroup>

  <!-- .NET Framework 4.7.2 安全套件 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <!-- .NET 10.0 安全套件 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.NETCore.Platforms" Version="1.1.1" />
  </ItemGroup>

  <!-- 配置所有相依的 DLL 複製到輸出目錄 -->
  <Target Name="CopyDependencies" AfterTargets="Build">
    <ItemGroup>
      <DependenciesToCopy Include="$(OutDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DependenciesToCopy)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    發行輸出：Release 建置完成後，自動把元件、手冊與教學資料整理到專案根目錄的 publish\
      publish\bin\net472\       COM 用元件（已由 Costura 合併相依 DLL）
      publish\bin\net10.0\      .NET 10 元件
      publish\Manual\           使用手冊（md / html / pdf）
      publish\Examples\VBS\     VBScript 範例
      publish\Examples\LabVIEW\ LabVIEW 範例
      publish\Media\            操作截圖與教學影片
    Debug 建置不會輸出；如需輸出可加參數 -p:PublishToFolder=true。
  -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\'))</RepoRoot>
    <PublishRoot>$(RepoRoot)publish\</PublishRoot>
    <ReferenceRoot>$(RepoRoot)Reference\</ReferenceRoot>
    <PublishToFolder Condition="'$(PublishToFolder)' == '' And '$(Configuration)' == 'Release'">true</PublishToFolder>
  </PropertyGroup>

  <Target Name="CopyToPublishFolder" AfterTargets="Build" Condition="'$(PublishToFolder)' == 'true' And '$(TargetFramework)' != ''">
    <PropertyGroup>
      <PublishBinDir>$(PublishRoot)bin\$(TargetFramework)\</PublishBinDir>
    </PropertyGroup>
    <ItemGroup>
      <PublishBinFiles Include="$(OutDir)*.dll;$(OutDir)*.deps.json" />
      <PublishManualFiles Include="$(ReferenceRoot)Manual\**\*.*" />
      <PublishVbsFiles Include="$(ReferenceRoot)VBS\**\*.*" />
      <PublishPowerShellFiles Include="$(ReferenceRoot)PowerShell\**\*.*" />
      <PublishExampleReadme Include="$(ReferenceRoot)Examples-README.md" />
      <PublishLabviewFiles Include="$(ReferenceRoot)LabVIEW\**\*.*" />
      <PublishMediaFiles Include="$(ReferenceRoot)Media\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishBinFiles)" DestinationFolder="$(PublishBinDir)" />
    <Copy SourceFiles="@(PublishManualFiles)" DestinationFiles="@(PublishManualFiles->'$(PublishRoot)Manual\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublishVbsFiles)" DestinationFiles="@(PublishVbsFiles->'$(PublishRoot)Examples\VBS\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublishLabviewFiles)" DestinationFiles="@(PublishLabviewFiles->'$(PublishRoot)Examples\LabVIEW\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublishMediaFiles)" DestinationFiles="@(PublishMediaFiles->'$(PublishRoot)Media\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublishPowerShellFiles)" DestinationFiles="@(PublishPowerShellFiles->'$(PublishRoot)Examples\PowerShell\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublishExampleReadme)" DestinationFiles="@(PublishExampleReadme->'$(PublishRoot)Examples\README.md')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="ExcelKit $(Version) ($(TargetFramework)) 已輸出至 $(PublishRoot)" />
  </Target>

</Project>


